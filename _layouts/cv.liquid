---
layout: default
---
{% unless site.data.resume %}
  <div class="post">
    {% include cv/print_header.liquid %}
    <header class="post-header d-print-none">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
      {% if page.cv_pdfs %}
        <div class="container-pdf">
          {% for pdf in page.cv_pdfs %}
            <div class="container-link-button">
              <a
                {% if pdf.file contains '://' %}
                  href="{{ pdf.file }}"
                {% else %}
                  href="{{ pdf.file | prepend: 'assets/pdf/' | relative_url }}"
                {% endif %}
                target="_blank"
                rel="noopener noreferrer"
                class="btncv z-depth-0"
              >
                <i class="fa-solid fa-file-pdf"></i>
                {{ pdf.label }}
              </a>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for entry in site.data.cv %}
          <a class="anchor" id="{{ entry.title }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
            <div>
              {% if entry.type == 'list' %}
                {% include cv/list.liquid %}
              {% elsif entry.type == 'map' %}
                {% include cv/map.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% elsif entry.type == 'list_groups' %}
                {% include cv/list_groups.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <div class="post">
    {% include cv/print_header.liquid %}
    <header class="post-header d-print-none">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
      {% if page.cv_pdfs %}
        <div class="container-pdf">
          {% for pdf in page.cv_pdfs %}
            <div class="container-link-button">
              <a
                {% if pdf.file contains '://' %}
                  href="{{ pdf.file }}"
                {% else %}
                  href="{{ pdf.file | prepend: 'assets/pdf/' | relative_url }}"
                {% endif %}
                target="_blank"
                rel="noopener noreferrer"
                class="btncv z-depth-0"
              >
                <i class="fa-solid fa-file-pdf"></i>
                {{ pdf.label }}
              </a>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </header>

    <article>
      {% assign cv_sidebar_sections = 'certificates,skills,languages' | split: ',' %}

      <!-- Single-column layout, shown on screen -->
      <div class="cv d-print-none">
        {% for data in site.data.resume %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' %} {% continue %} {% endif %}
          {% if data[0] != 'publications' and data[1].size == 0 %} {% continue %} {% endif %}
          {% include resume/_card.liquid %}
        {% endfor %}
      </div>

      <!--
        Two-column layout, shown only when printing: a narrow sidebar for
        short list-like sections (Certificates/Skills/Languages) alongside a
        wide main column for sections with their own date/location
        sub-layout (Work/Education/Publications) — see _sass/_print.scss.
      -->
      <div class="cv d-none d-print-flex cv-print-resume">
        <div class="cv-col-side">
          {% assign cv_sidebar_order = 'skills,certificates,languages' | split: ',' %}
          {% for wanted_key in cv_sidebar_order %}
            {% for data in site.data.resume %}
              {% unless data[0] == wanted_key %} {% continue %} {% endunless %}
              {% if site.jsonresume and site.jsonresume.size > 0 %}
                {% unless site.jsonresume contains data[0] %}
                  {% continue %}
                {% endunless %}
              {% endif %}
              {% if data[1].size == 0 %} {% continue %} {% endif %}
              {% include resume/_card.liquid %}
            {% endfor %}
          {% endfor %}
        </div>
        <div class="cv-col-main">
          {% for data in site.data.resume %}
            {% if site.jsonresume and site.jsonresume.size > 0 %}
              {% unless site.jsonresume contains data[0] %}
                {% continue %}
              {% endunless %}
            {% endif %}
            {% if data[0] == 'meta' or data[0] == 'basics' %} {% continue %} {% endif %}
            {% if data[0] != 'publications' and data[1].size == 0 %} {% continue %} {% endif %}
            {% if cv_sidebar_sections contains data[0] %} {% continue %} {% endif %}
            {% include resume/_card.liquid %}
          {% endfor %}
        </div>
      </div>
    </article>
  </div>
{% endunless %}
